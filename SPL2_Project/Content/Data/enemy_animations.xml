<?xml version="1.0" encoding="utf-8" ?>
<!--
  Enemy animation definitions.
  atlas:       content path of the shared sprite sheet
  frameWidth/frameHeight: pixel size of each frame in the sheet
  frames:      0-based frame indices, comma-separated
  interval:    seconds per frame
-->
<EnemyAnimations atlas="images/atlas" frameWidth="16" frameHeight="16">

  <Enemy type="skeleton" width="16" height="16" walkSpeed="20" health="1">
    <Animation name="walk-down"  frames="9,10,11,10"   interval="0.2" />
    <Animation name="walk-left"  frames="21,22,23,22"  interval="0.2" />
    <Animation name="walk-right" frames="33,34,35,34"  interval="0.2" />
    <Animation name="walk-up"    frames="45,46,47,46"  interval="0.2" />
    <Animation name="idle-down"  frames="10"           interval="0.2" />
    <Animation name="idle-left"  frames="22"           interval="0.2" />
    <Animation name="idle-right" frames="34"           interval="0.2" />
    <Animation name="idle-up"    frames="46"           interval="0.2" />
  </Enemy>

</EnemyAnimations>